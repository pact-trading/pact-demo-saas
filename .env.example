# Pact API. The hosted testnet is https://api.pactagent.app; a local stack is http://127.0.0.1:3001.
PACT_API_URL=http://127.0.0.1:3001
# Dashboard → Developers → API keys → New key (secret). Stays on this server.
PACT_SECRET_KEY=
# Dashboard → Developers → Webhooks: set the URL to http://localhost:3230/api/webhooks/pact, copy the secret.
PACT_WEBHOOK_SECRET=
# Optional: only these plan ids, comma separated (default: every active plan).
PACT_PLAN_IDS=
# Pact's hosted checkout, opened by the <Subscribe> button.
NEXT_PUBLIC_PACT_CHECKOUT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.whitechain.io
